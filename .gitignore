# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Originaux Figma : lourds (80 Mo pour 23 oeuvres) et régénérables via
# scripts/extraire-figma.mjs. Seul public/img/ (les variantes servies) est versionné.
/sources/

# Captures de vérification visuelle, régénérables
/.captures/
# Référence locale du comparateur (cp -r .captures .captures-reference)
/.captures-reference/
